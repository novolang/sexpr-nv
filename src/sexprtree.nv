// sexprtree — the nodes of an S-expression, in an arena over the bytes.
//
// `parse` reads the input once with the `sexprscan` scanner and answers
// a tree.  The tree is an arena: nodes are numbered in the order they
// begin, the root is node 0, and a node is an `Int` that the caller can
// hold without holding anything else.  Every node records
//
//   its kind        a list, a bare atom or a quoted string
//   its byte range  half-open, into the bytes that were parsed; for a
//                   list the range runs from the `(` to the byte after
//                   the matching `)`
//   its position    the line and the column of its first byte, for the
//                   message a tool prints about it
//   its first child and its next sibling
//
// and nothing else.  The text of an atom or a string is not copied out
// when the tree is built: `text` slices the source on request, and
// unescapes a quoted string only then.  A board of several megabytes
// therefore costs seven integers per node plus the source itself, and
// no `Str` per node.
//
// The tree holds the source, so the bytes the caller parsed stay alive
// as long as the tree does.
//
// Escapes in a quoted string follow KiCad's reader.  `\a`, `\b`, `\f`,
// `\n`, `\r`, `\t` and `\v` are the control bytes of the same letters,
// `\x` followed by one or two hexadecimal digits is that byte, a
// backslash followed by one to three octal digits is that byte, and a
// backslash before any other byte, a quote or a backslash among them,
// stands for that byte.  A `\x` with no digit after it stands for `x`.

use std.bytes
use std.str
use sexprerr
use sexprscan

// The kind of a node that is a list.
pub const NODE_LIST = 0

// The kind of a node that is a bare atom.
pub const NODE_ATOM = 1

// The kind of a node that is a quoted string.
pub const NODE_STRING = 2

// The deepest nesting `parse` accepts.
pub const DEFAULT_MAX_DEPTH = 256

// A parsed S-expression: seven parallel lists indexed by node number.
//
// The lists are an implementation detail; use the functions of this
// module.
pub struct SexprTree
    src: Bytes
    kinds: [Int]
    from: [Int]
    to: [Int]
    lines: [Int]
    cols: [Int]
    firsts: [Int]
    nexts: [Int]

// Parses the one form `src` holds.
//
// The answer is a tree whose root, node 0, is that form.  Nothing but
// white space may come after it.  An empty input, an unbalanced
// parenthesis, a string with no end, a second form and nesting past
// `DEFAULT_MAX_DEPTH` are faults, each with the line and column.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     match sexprtree.parse(bytes.from_str("(at 100 50)"))
//         Err(e) => println(e.message())
//         Ok(t)  => println("${sexprtree.count(t)} nodes")   // 4 nodes
// ```
pub fn parse(src: Bytes) -> Result<SexprTree, sexprerr.SexprFault> []
    parse_with(src, DEFAULT_MAX_DEPTH)

// `parse` with the deepest nesting chosen by the caller.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     match sexprtree.parse_with(bytes.from_str("((()))"), 2)
//         Err(e) => println(e.message())   // 1:3: lists nest deeper than 2 levels
//         Ok(t)  => println("${sexprtree.count(t)}")
// ```
pub fn parse_with(src: Bytes, max_depth: Int) -> Result<SexprTree, sexprerr.SexprFault> []
    var sc = sexprscan.scanner(src, max_depth)
    var kinds: [Int] = []
    var from: [Int] = []
    var to: [Int] = []
    var lines: [Int] = []
    var cols: [Int] = []
    var firsts: [Int] = []
    var nexts: [Int] = []
    // The open lists: the node of each, and the last child it has so far.
    var open_node: [Int] = []
    var open_last: [Int] = []
    var sp = 0
    var done = false
    loop
        match sexprscan.next(var sc)
            Err(e) =>
                return Err(e)
            Ok(t)  =>
                if t.kind == sexprscan.TOK_END
                    break
                if t.kind == sexprscan.TOK_CLOSE
                    to[open_node[sp - 1]] = t.to
                    sp -= 1
                else
                    let id = list.len(kinds)
                    if sp == 0 and id > 0
                        return Err(sexprerr.SexprTrailing(t.line, t.col))
                    list.push(kinds, node_kind(t.kind))
                    list.push(from, t.from)
                    list.push(to, t.to)
                    list.push(lines, t.line)
                    list.push(cols, t.col)
                    list.push(firsts, -1)
                    list.push(nexts, -1)
                    if sp > 0
                        if open_last[sp - 1] < 0
                            firsts[open_node[sp - 1]] = id
                        else
                            nexts[open_last[sp - 1]] = id
                        open_last[sp - 1] = id
                    if t.kind == sexprscan.TOK_OPEN
                        if sp < list.len(open_node)
                            open_node[sp] = id
                            open_last[sp] = -1
                        else
                            list.push(open_node, id)
                            list.push(open_last, -1)
                        sp += 1
    if list.len(kinds) == 0
        return Err(sexprerr.SexprEmpty)
    Ok(SexprTree { src: src,
        kinds: kinds,
        from: from,
        to: to,
        lines: lines,
        cols: cols,
        firsts: firsts,
        nexts: nexts })

// The node kind of a scanner token kind.
fn node_kind(tok: Int) -> Int
    if tok == sexprscan.TOK_ATOM
        NODE_ATOM
    elif tok == sexprscan.TOK_STRING
        NODE_STRING
    else
        NODE_LIST

// ── Shape ───────────────────────────────────────────────────────────

// The root: the one form the input held.  Always node 0.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a)"))!
//     println("${sexprtree.root(t)}")   // 0
// ```
pub fn root(t: SexprTree) -> Int []
    0

// How many nodes the tree has.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a (b) \"c\")"))!
//     println("${sexprtree.count(t)}")   // 5
// ```
pub fn count(t: SexprTree) -> Int []
    list.len(t.kinds)

// The kind of node `n`: `NODE_LIST`, `NODE_ATOM` or `NODE_STRING`.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a)"))!
//     println("${sexprtree.kind_of(t, 1) == sexprtree.NODE_ATOM}")   // true
// ```
pub fn kind_of(t: SexprTree, n: Int) -> Int []
    t.kinds[n]

// Whether node `n` is a list.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a)"))!
//     println("${sexprtree.is_list(t, 0)}")   // true
// ```
pub fn is_list(t: SexprTree, n: Int) -> Bool []
    t.kinds[n] == NODE_LIST

// Whether node `n` is a bare atom.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a)"))!
//     println("${sexprtree.is_atom(t, 1)}")   // true
// ```
pub fn is_atom(t: SexprTree, n: Int) -> Bool []
    t.kinds[n] == NODE_ATOM

// Whether node `n` is a quoted string.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(\"a\")"))!
//     println("${sexprtree.is_string(t, 1)}")   // true
// ```
pub fn is_string(t: SexprTree, n: Int) -> Bool []
    t.kinds[n] == NODE_STRING

// ── Position ────────────────────────────────────────────────────────

// The line of the first byte of node `n`, counted from 1.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a\n  (b))"))!
//     println("${sexprtree.line_of(t, 2)}")   // 2
// ```
pub fn line_of(t: SexprTree, n: Int) -> Int []
    t.lines[n]

// The column of the first byte of node `n`, counted from 1 in bytes.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a\n  (b))"))!
//     println("${sexprtree.col_of(t, 2)}")   // 3
// ```
pub fn col_of(t: SexprTree, n: Int) -> Int []
    t.cols[n]

// The offset of the first byte of node `n` in the parsed bytes.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(ab cd)"))!
//     println("${sexprtree.from_of(t, 2)}")   // 4
// ```
pub fn from_of(t: SexprTree, n: Int) -> Int []
    t.from[n]

// The offset one past the last byte of node `n`.  For a list it is the
// byte after the closing parenthesis.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(ab cd)"))!
//     println("${sexprtree.to_of(t, 0)}")   // 7
// ```
pub fn to_of(t: SexprTree, n: Int) -> Int []
    t.to[n]

// The text a position prints as: `line:col`.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a\n  (b))"))!
//     println(sexprtree.where_is(t, 2))   // 2:3
// ```
pub fn where_is(t: SexprTree, n: Int) -> Str []
    "${t.lines[n]}:${t.cols[n]}"

// ── Navigation ──────────────────────────────────────────────────────

// The first child of list `n`, or -1 when `n` is empty or not a list.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a b)"))!
//     println("${sexprtree.first_child(t, 0)}")   // 1
// ```
pub fn first_child(t: SexprTree, n: Int) -> Int []
    t.firsts[n]

// The sibling after node `n`, or -1 when `n` is the last of its list.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a b)"))!
//     println("${sexprtree.next_sibling(t, 1)}")   // 2
// ```
pub fn next_sibling(t: SexprTree, n: Int) -> Int []
    t.nexts[n]

// The children of list `n`, in order.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a (b) c)"))!
//     println("${sexprtree.children(t, 0)}")   // [1, 2, 4]
// ```
pub fn children(t: SexprTree, n: Int) -> [Int] []
    var out: [Int] = []
    var c = t.firsts[n]
    while c >= 0
        list.push(out, c)
        c = t.nexts[c]
    out

// How many children list `n` has.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a (b) c)"))!
//     println("${sexprtree.child_count(t, 0)}")   // 3
// ```
pub fn child_count(t: SexprTree, n: Int) -> Int []
    var k = 0
    var c = t.firsts[n]
    while c >= 0
        k += 1
        c = t.nexts[c]
    k

// The child of list `n` at index `i` from 0, or -1 when there is none.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a (b) c)"))!
//     println("${sexprtree.nth(t, 0, 2)}")   // 4
// ```
pub fn nth(t: SexprTree, n: Int, i: Int) -> Int []
    var c = t.firsts[n]
    var k = 0
    while c >= 0 and k < i
        c = t.nexts[c]
        k += 1
    if i < 0
        -1
    else
        c

// ── Text ────────────────────────────────────────────────────────────

// The text of node `n`: an atom's bytes, or a quoted string's content
// with its escapes decoded and its quotes removed.  A list answers the
// empty string; use `source_of` for the bytes of a whole list.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a \"b\\nc\")"))!
//     println(sexprtree.text(t, 1))   // a
//     println(sexprtree.text(t, 2))   // b<newline>c
// ```
pub fn text(t: SexprTree, n: Int) -> Str []
    if t.kinds[n] == NODE_ATOM
        bytes.to_str(bytes.slice(t.src, t.from[n], t.to[n]))
    elif t.kinds[n] == NODE_STRING
        unquote(bytes.slice(t.src, t.from[n] + 1, t.to[n] - 1))
    else
        ""

// The bytes node `n` occupied in the source, as written, quotes and
// escapes included.  For a list it is the whole form from `(` to `)`.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(a (b  c))"))!
//     println(sexprtree.source_of(t, 2))   // (b  c)
// ```
pub fn source_of(t: SexprTree, n: Int) -> Str []
    bytes.to_str(bytes.slice(t.src, t.from[n], t.to[n]))

// The head of list `n`: the text of its first child when that child is
// an atom or a string, and the empty string otherwise.  `(at 1 2)` has
// the head `at`.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(at 1 2)"))!
//     println(sexprtree.head(t, 0))   // at
// ```
pub fn head(t: SexprTree, n: Int) -> Str []
    let c = t.firsts[n]
    if t.kinds[n] != NODE_LIST or c < 0 or t.kinds[c] == NODE_LIST
        ""
    else
        text(t, c)

// The first child of list `n` that is a list with the head `name`, or
// -1.  `find(t, board, "at")` is the `(at …)` of a footprint.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(fp (layer F) (at 1 2))"))!
//     println("${sexprtree.find(t, 0, "at")}")   // 5
// ```
pub fn find(t: SexprTree, n: Int, name: Str) -> Int []
    var c = t.firsts[n]
    while c >= 0 and not (t.kinds[c] == NODE_LIST and head(t, c) == name)
        c = t.nexts[c]
    c

// Every child of list `n` that is a list with the head `name`, in order.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(fp (pad 1) (at 1 2) (pad 2))"))!
//     println("${sexprtree.find_all(t, 0, "pad")}")   // [2, 7]
// ```
pub fn find_all(t: SexprTree, n: Int, name: Str) -> [Int] []
    var out: [Int] = []
    var c = t.firsts[n]
    while c >= 0
        if t.kinds[c] == NODE_LIST and head(t, c) == name
            list.push(out, c)
        c = t.nexts[c]
    out

// ── Numbers ─────────────────────────────────────────────────────────

// The integer a bare atom spells, or `None` for any other node or an
// atom that is not a whole decimal number.  A quoted string is never a
// number, which is how KiCad tells `(layer "1")` from `(version 1)`.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(version 20240108)"))!
//     println("${sexprtree.as_int(t, 2) ?? -1}")   // 20240108
// ```
pub fn as_int(t: SexprTree, n: Int) -> ?Int []
    if t.kinds[n] == NODE_ATOM
        str.to_int(text(t, n))
    else
        None

// The number a bare atom spells, or `None` for any other node or an
// atom that is not a decimal number.  An integer atom is a number too.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     let t = sexprtree.parse(bytes.from_str("(at 12.7 -3)"))!
//     println("${sexprtree.as_float(t, 2) ?? 0.0}")   // 12.7
// ```
pub fn as_float(t: SexprTree, n: Int) -> ?Float []
    if t.kinds[n] == NODE_ATOM
        str.to_float(text(t, n))
    else
        None

// ── Escapes ─────────────────────────────────────────────────────────

// The value of a hexadecimal digit byte, or -1.
fn hex_digit(b: Int) -> Int
    if b >= '0' and b <= '9'
        b - '0'
    elif b >= 'a' and b <= 'f'
        b - 'a' + 10
    elif b >= 'A' and b <= 'F'
        b - 'A' + 10
    else
        -1

// The byte a one-letter escape stands for, or -1 for a letter that is
// not an escape of its own.
fn simple_escape(c: Int) -> Int
    match c
        97  => 7
        98  => 8
        102 => 12
        110 => 10
        114 => 13
        116 => 9
        118 => 11
        _   => -1

// The content of a quoted string, between its quotes, with the escapes
// decoded.  An unquoted run with no backslash is returned as it is.
//
// ```novo
// use std.bytes
// use sexprtree
//
// fn main() [io]
//     println(sexprtree.unquote(bytes.from_str("a\\x41\\101\\\"")))   // aAA"
// ```
pub fn unquote(inner: Bytes) -> Str []
    if bytes.find_byte_or(inner, 92, 0, -1) < 0
        return bytes.to_str(inner)
    var out: [Int] = []
    let n = bytes.len(inner)
    var i = 0
    while i < n
        let b = bytes.byte_at(inner, i) ?? 0
        if b != 92 or i + 1 >= n
            list.push(out, b)
            i += 1
        else
            let c = bytes.byte_at(inner, i + 1) ?? 0
            i += 2
            if simple_escape(c) >= 0
                list.push(out, simple_escape(c))
            elif c == 'x' and hex_digit(bytes.byte_at(inner, i) ?? -1) >= 0
                var v = hex_digit(bytes.byte_at(inner, i) ?? -1)
                i += 1
                if hex_digit(bytes.byte_at(inner, i) ?? -1) >= 0
                    v = v * 16 + hex_digit(bytes.byte_at(inner, i) ?? -1)
                    i += 1
                list.push(out, v)
            elif c >= '0' and c <= '7'
                var v = c - '0'
                var k = 0
                while k < 2 and (bytes.byte_at(inner, i) ?? -1) >= '0' and (bytes.byte_at(inner, i) ?? -1) <= '7'
                    v = v * 8 + (bytes.byte_at(inner, i) ?? 0) - '0'
                    i += 1
                    k += 1
                list.push(out, v % 256)
            else
                list.push(out, c)
    bytes.byte_list_to_str(out)
