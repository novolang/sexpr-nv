// sexpr_edge_tests — what the reader refuses, the escapes, the limits
// and the shapes at the edge of the grammar.

use std.test
use std.bytes
use std.str
use sexprerr
use sexprscan
use sexprtree

fn b(s: Str) -> Bytes
    bytes.from_str(s)

// The fault `parse` answers for `s`, as `code line:col`, or `ok`.
fn fault_of(s: Str) -> Str
    match sexprtree.parse(b(s))
        Ok(_)  => "ok"
        Err(e) => "${sexprerr.code_of(e)} ${sexprerr.line_of(e)}:${sexprerr.col_of(e)}"

// The text of the one string a form holds, decoded.
fn decoded(s: Str) -> Str
    match sexprtree.parse(b(s))
        Ok(t)  => sexprtree.text(t, 1)
        Err(e) => e.message()

// ── Faults, each with its position ──────────────────────────────────

@test
fn test_empty_input_and_white_space_hold_no_form()
    test.assert_eq(fault_of(""), "empty 0:0")
    test.assert_eq(fault_of("  \n\t \r\n"), "empty 0:0")

@test
fn test_a_close_with_no_open_names_its_position()
    test.assert_eq(fault_of(")"), "unbalanced-close 1:1")
    test.assert_eq(fault_of("(a)\n  )"), "unbalanced-close 2:3")

@test
fn test_an_unclosed_list_names_the_innermost_open_one()
    test.assert_eq(fault_of("(a"), "unclosed-list 1:1")
    test.assert_eq(fault_of("(a\n  (b\n    (c)"), "unclosed-list 2:3")
    test.assert_eq(fault_of("(a (b) (c"), "unclosed-list 1:8")

@test
fn test_a_string_that_never_ends_names_where_it_began()
    test.assert_eq(fault_of("(a \"b"), "unterminated-string 1:4")
    test.assert_eq(fault_of("(a\n \"b\\\""), "unterminated-string 2:2")
    test.assert_eq(fault_of("(a \"b\\"), "unterminated-string 1:4")

@test
fn test_a_second_top_level_form_is_a_fault_whatever_its_kind()
    test.assert_eq(fault_of("(a) (b)"), "trailing 1:5")
    test.assert_eq(fault_of("(a)\n\nb"), "trailing 3:1")
    test.assert_eq(fault_of("(a) \"b\""), "trailing 1:5")
    test.assert_eq(fault_of("a b"), "trailing 1:3")

@test
fn test_a_lone_atom_or_string_is_a_form()
    test.assert_eq(fault_of("a"), "ok")
    test.assert_eq(fault_of("\"a\""), "ok")
    test.assert_eq(fault_of("()"), "ok")

@test
fn test_nesting_past_the_limit_is_refused_at_the_paren_that_passes_it()
    test.assert_eq(fault_of("((((a))))"), "ok")
    match sexprtree.parse_with(b("(\n ((a)))"), 2)
        Ok(_)  => test.fail("three levels exceed a limit of two")
        Err(e) =>
            test.assert_eq(sexprerr.code_of(e), "too-deep")
            test.assert_eq(sexprerr.line_of(e), 2)
            test.assert_eq(sexprerr.col_of(e), 3)
            test.assert_eq(e.message(), "2:3: lists nest deeper than 2 levels")
    match sexprtree.parse_with(b("((a))"), 2)
        Ok(t)  => test.assert_eq(sexprtree.count(t), 3)
        Err(e) => test.fail(e.message())

@test
fn test_a_hostile_run_of_open_parentheses_is_a_fault_and_not_a_crash()
    let deep = str.repeat("(", 100000)
    match sexprtree.parse(b(deep))
        Ok(_)  => test.fail("that nests far past the limit")
        Err(e) => test.assert_eq(sexprerr.code_of(e), "too-deep")
    match sexprscan.walk(b(deep), 100000000, (k, f, t, l, c) => true)
        Ok(_)  => test.fail("the lists never close")
        Err(e) => test.assert_eq(sexprerr.code_of(e), "unclosed-list")

@test
fn test_every_fault_has_a_message_with_its_position()
    test.assert_eq(sexprerr.SexprUnterminatedString(1, 2).message(),
        "1:2: the quoted string opened here is never closed")
    test.assert_eq(sexprerr.SexprUnbalancedClose(3, 4).message(), "3:4: a `)` closes nothing")
    test.assert_eq(sexprerr.SexprUnclosedList(5, 6).message(), "5:6: the list opened here is never closed")
    test.assert_eq(sexprerr.SexprTooDeep(7, 8, 9).message(), "7:8: lists nest deeper than 9 levels")
    test.assert_eq(sexprerr.SexprEmpty.message(), "the input holds no form")
    test.assert_eq(sexprerr.SexprTrailing(1, 5).message(), "1:5: a second form follows the first")
    test.assert_eq(sexprerr.col_of(sexprerr.SexprEmpty), 0)
    test.assert_eq(sexprerr.line_of(sexprerr.SexprEmpty), 0)

// ── Escapes ─────────────────────────────────────────────────────────

@test
fn test_the_one_letter_escapes_are_the_control_bytes()
    test.assert_eq(decoded("(\"a\\nb\")"), "a\nb")
    test.assert_eq(decoded("(\"a\\rb\")"), "a\rb")
    test.assert_eq(decoded("(\"a\\tb\")"), "a\tb")
    test.assert_eq(bytes.to_hex(bytes.from_str(decoded("(\"\\a\\b\\f\\v\")"))), "07080c0b")

@test
fn test_a_backslash_before_any_other_byte_is_that_byte()
    test.assert_eq(decoded("(\"a\\\\b\")"), "a\\b")
    test.assert_eq(decoded("(\"a\\\"b\")"), "a\"b")
    test.assert_eq(decoded("(\"a\\qb\")"), "aqb")
    test.assert_eq(decoded("(\"a\\(b\\)\")"), "a(b)")

@test
fn test_hex_escapes_take_one_or_two_digits()
    test.assert_eq(decoded("(\"\\x41\")"), "A")
    test.assert_eq(decoded("(\"\\x4a\")"), "J")
    test.assert_eq(decoded("(\"\\x4AB\")"), "JB")
    test.assert_eq(decoded("(\"\\x7\")"), "\u{7}")
    test.assert_eq(decoded("(\"\\xg\")"), "xg")
    test.assert_eq(decoded("(\"\\x\")"), "x")

@test
fn test_octal_escapes_take_up_to_three_digits()
    test.assert_eq(decoded("(\"\\101\")"), "A")
    test.assert_eq(decoded("(\"\\1011\")"), "A1")
    test.assert_eq(decoded("(\"\\7\")"), "\u{7}")
    test.assert_eq(decoded("(\"\\08\")"), "\u{0}8")
    test.assert_eq(bytes.to_hex(bytes.from_str(decoded("(\"\\777\")"))), "ff")

@test
fn test_a_string_may_hold_a_raw_newline_and_the_lines_still_count()
    match sexprtree.parse(b("(a \"x\ny\" b)"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.text(t, 2), "x\ny")
            test.assert_eq(sexprtree.where_is(t, 3), "2:4")
    match sexprtree.parse(b("(a \"x\\\ny\" b)"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.text(t, 2), "x\ny")
            test.assert_eq(sexprtree.where_is(t, 3), "2:4")

@test
fn test_utf8_passes_through_and_columns_count_bytes()
    match sexprtree.parse(b("(a \"Ω 10k\" b)"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.text(t, 2), "Ω 10k")
            // The omega is two bytes, so `b` is at byte column 13.
            test.assert_eq(sexprtree.col_of(t, 3), 13)

@test
fn test_unquote_leaves_a_run_without_a_backslash_alone()
    test.assert_eq(sexprtree.unquote(b("plain")), "plain")
    test.assert_eq(sexprtree.unquote(b("")), "")
    test.assert_eq(sexprtree.unquote(b("trailing\\")), "trailing\\")

// ── Shapes at the edge of the grammar ───────────────────────────────

@test
fn test_atoms_may_hold_punctuation_a_number_parser_would_refuse()
    match sexprtree.parse(b("(net-name +3V3 ~{RESET} 1.5mm F.Cu /Sheet/GND a;b)"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.text(t, 1), "net-name")
            test.assert_eq(sexprtree.text(t, 2), "+3V3")
            test.assert_eq(sexprtree.text(t, 3), "~{RESET}")
            test.assert_eq(sexprtree.text(t, 4), "1.5mm")
            test.assert_eq(sexprtree.text(t, 6), "/Sheet/GND")
            test.assert_eq(sexprtree.text(t, 7), "a;b")
            test.assert_none(sexprtree.as_float(t, 4))

@test
fn test_white_space_between_tokens_is_any_run_of_blanks()
    match sexprtree.parse(b("\t(  a\r\n\tb\t\t\"c\"\n\n)\n\n"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.children(t, 0), [1, 2, 3])
            test.assert_eq(sexprtree.where_is(t, 0), "1:2")
            test.assert_eq(sexprtree.where_is(t, 2), "2:2")

@test
fn test_parentheses_need_no_space_around_them()
    match sexprtree.parse(b("(a(b)(c(d)))"))
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            test.assert_eq(sexprtree.count(t), 8)
            test.assert_eq(sexprtree.child_count(t, 0), 3)
            test.assert_eq(sexprtree.source_of(t, 0), "(a(b)(c(d)))")

@test
fn test_a_scanner_that_sees_a_faulty_close_stays_where_it_was()
    var sc = sexprscan.scanner(b(")"), 4)
    match sexprscan.next(var sc)
        Ok(_)  => test.fail("a close with no open")
        Err(e) => test.assert_eq(sexprerr.code_of(e), "unbalanced-close")
    test.assert_eq(sexprscan.depth(sc), 0)

@test
fn test_a_reused_open_slot_keeps_the_positions_of_the_new_list()
    // Two sibling lists reuse the same place in the open stack.
    var sc = sexprscan.scanner(b("((a)\n  (b"), 8)
    var last = "none"
    loop
        match sexprscan.next(var sc)
            Err(e) =>
                last = e.message()
                break
            Ok(t)  =>
                if t.kind == sexprscan.TOK_END
                    break
    test.assert_eq(last, "2:3: the list opened here is never closed")
